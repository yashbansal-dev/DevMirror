    { "path": "plugins/postgres" },
    { "path": "plugins/redis" },
    { "path": "packages/detectors" },
    { "path": "packages/analyzer" },
    { "path": "packages/environment" },
    { "path": "packages/docker" },
    { "path": "packages/services" },
    { "path": "packages/runtime" },
    { "path": "packages/diagnostics" },
    { "path": "packages/snapshots" },
    { "path": "packages/ai" },
    { "path": "apps/cli" }
  ]
}
